          "informationUri": "https://detekt.dev",
          "language": "en",
          "name": "detekt",
          "organization": "detekt",
          "rules": [
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "error"
              },
              "helpUri": "https://detekt.dev/docs/2.0.0-alpha.6/rules/empty-blocks#emptycatchblock",
              "id": "detekt.empty-blocks.EmptyCatchBlock",
              "name": "EmptyCatchBlock",
              "shortDescription": {
                "text": "Empty catch block detected. Empty catch blocks indicate that an exception is ignored and not handled."
              }
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "error"
              },
              "helpUri": "https://mrmans0n.github.io/compose-rules/rules/#parameter-order",
              "id": "detekt.Compose.ComposableParamOrder",
              "name": "ComposableParamOrder",
              "shortDescription": {
                "text": "Parameters in Composable functions should be ordered correctly"
              }
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "error"
              },
              "helpUri": "https://detekt.dev/docs/2.0.0-alpha.6/rules/libraries#forbiddenpublicdataclass",
              "id": "detekt.libraries.ForbiddenPublicDataClass",
              "name": "ForbiddenPublicDataClass",
              "shortDescription": {
                "text": "The data classes are bad for the binary compatibility in public APIs. Avoid to use it."
              }
            }
          ]
        }
