          "message": {
            "text": "Parameters in a composable function should be ordered following this pattern: params without defaults, modifiers, params with defaults and optionally, a trailing function that might not have a default param.\nCurrent params are: [optional: String = \"\", required: Int] but could be [required: Int, optional: String = \"\"].\nSee https://mrmans0n.github.io/compose-rules/rules/#ordering-composable-parameters-properly for more information."
          },
          "partialFingerprints": {
            "signature/v1": "32d202b4b805b7fe355abc151e25d30327309692"
          },
          "ruleId": "detekt.Compose.ComposableParamOrder"
